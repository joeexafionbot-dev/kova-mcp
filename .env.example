# =============================================================================
# myGEKKO MCP — environment configuration TEMPLATE
# Copy to `.env` and fill in. NEVER put real secrets in THIS file — it is the
# shareable template. Real values go in `.env` (git-ignored).
# GEKKO_KEY / passwords are redacted in all logs by the server.
# =============================================================================

# --- Backend selection -------------------------------------------------------
# Only "rest" is implemented in Stage 1. (mqtt is a later phase.)
GEKKO_BACKEND=rest

# --- Connection mode ---------------------------------------------------------
# "cloud"  -> myGEKKO Plus, https://live.my-gekko.com (DEFAULT, HTTPS-only)
# "local"  -> direct to the controller on your LAN (http/https, secured net only)
GEKKO_MODE=cloud

# --- CLOUD mode (GEKKO_MODE=cloud) -------------------------------------------
# Get these from the controller:
#   KEY     : Zahnrad > Einstellungen > 3. Tab (Globus) > "Plus Erweitert"
#             > "Plus Query API" > "Verwaltung >" > "Neu generieren"
#   GEKKOID : Zahnrad > Systeminfo > myGEKKO ID   (format XXXX-XXXX-XXXX-XXXX)
#   USERNAME: your myGEKKO Plus username (email)
# Requires: controller registered on my-gekko.com AND the "myGEKKO Query API"
# Plus service subscribed.
GEKKO_USERNAME=you@example.com
GEKKO_KEY=
GEKKO_GEKKOID=XXXX-XXXX-XXXX-XXXX

# --- LOCAL mode (GEKKO_MODE=local) -------------------------------------------
# Only used when GEKKO_MODE=local. Requires "Lokaler Webserver / Query API HTTP"
# enabled on the controller and a Query API user created.
# WARNING: local Query API is reachable over HTTP (port 80). Use only inside a
# trusted network; never expose port 80 publicly.
GEKKO_LOCAL_HOST=192.168.1.50
GEKKO_LOCAL_SCHEME=http
# GEKKO_USERNAME is reused as the local username.
GEKKO_LOCAL_PASSWORD=

# --- Safety / write gate -----------------------------------------------------
# Master switch. Stays false until you have reviewed the generated tools.
GEKKO_ALLOW_WRITE=false
# Comma-separated system keys that are ALWAYS blocked for writes, even if
# GEKKO_ALLOW_WRITE=true. Safety-critical trades.
GEKKO_DENY_SYSTEMS=alarmsystem,accessdoors,door_intercom
# Optional explicit allow-list of system keys for writes (empty = all non-denied).
GEKKO_ALLOW_SYSTEMS=

# --- HTTP client tuning ------------------------------------------------------
GEKKO_TIMEOUT_SECONDS=10
# The Query API subscribes on first read and may need a re-poll after ~2s.
GEKKO_REPOLL_DELAY_SECONDS=2.0
GEKKO_REPOLL_MAX_ATTEMPTS=3

# --- Logging / audit ---------------------------------------------------------
GEKKO_LOG_LEVEL=INFO
GEKKO_AUDIT_PATH=audit/audit.jsonl

# --- Streamable-HTTP transport (Claude-app connector, Phase 2) ---------------
# Only used with: mygekko-mcp --transport streamable-http
# Bind to loopback; put a TLS reverse proxy (nginx) in front. Never expose this
# port directly to the internet.
GEKKO_HTTP_HOST=127.0.0.1
GEKKO_HTTP_PORT=8000
GEKKO_HTTP_PATH=/mcp
# Bearer token the connector must send (treat like a password). Generate e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GEKKO_HTTP_TOKEN=
# Set true ONLY for a trusted local test to run HTTP without a token.
GEKKO_HTTP_ALLOW_NO_AUTH=false
